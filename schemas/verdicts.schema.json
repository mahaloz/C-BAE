{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Address-keyed semantic function-name verdicts",
  "type": "object",
  "propertyNames": {"pattern": "^0x[0-9a-fA-F]+$"},
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": ["verdict", "justification", "confidence"],
    "properties": {
      "verdict": {"enum": ["exact", "equivalent", "partial", "incorrect", "ungradable"]},
      "justification": {"type": "string", "minLength": 1, "maxLength": 500},
      "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0}
    }
  }
}
